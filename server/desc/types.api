syntax = "v1"


type (
	CreateAccountReq {
		PublicKeyX   string `json:"publicKeyX"`
		PublicKeyY   string `json:"publicKeyY"`
		CredentialId string `json:"credentialId"`
	}
	CreateAccountResp  {}
)

type ChainInfo {
	ChainId string `json:"chainId"`
	Name    string `json:"name"`
}

type PermissionDetail {
	Type         string      `json:"type"`
	ProposedName string      `json:"proposedName"`
	Chains       []ChainInfo `json:"chains"`
	RuleTypes    []string    `json:"ruleTypes"`
}

type (
	GetSupportedPermissionsReq  {}
	GetSupportedPermissionsResp {
		Permissions []PermissionDetail `json:"permissions"`
	}
)


type PermissionInfo {
    Type string         `json:"type"`
    Data string         `json:"data"`
}

type Rule {
	Type string         `json:"type"`
	Data string 				`json:"data"`
}

type (
    SubmitPermissionReq {
        ChainId             string         `json:"chainId"`
				From 								string				 `json:"from,omitempty"`
        To                  string         `json:"to"`
        IsAdjustmentAllowed bool           `json:"isAdjustmentAllowed"`
        Permission          PermissionInfo `json:"permission"`
				Rules 							[]Rule			 	 `json:"rules"`
    }
    SubmitPermissionResp {}
)