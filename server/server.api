syntax = "v1"

type (
	CreateAccountReq {
		PublicKeyX   string `json:"publicKeyX"`
		PublicKeyY   string `json:"publicKeyY"`
		CredentialId string `json:"credentialId"`
	}
	CreateAccountResp  {}
)

type ChainInfo {
	ChainId string `json:"chainId"`
	Name    string `json:"name"`
}

type PermissionDetail {
	Type         string      `json:"type"`
	ProposedName string      `json:"proposedName"`
	Chains       []ChainInfo `json:"chains"`
	RuleTypes    []string    `json:"ruleTypes"`
}

type (
	GetSupportedPermissionsReq  {}
	GetSupportedPermissionsResp {
		Permissions []PermissionDetail `json:"permissions"`
	}
)

service server-api {
	@handler CreateAccount
	post /account/create (CreateAccountReq) returns (CreateAccountResp)

	@handler GetSupportedPermissions
	get /supported-permissions (GetSupportedPermissionsReq) returns (GetSupportedPermissionsResp)
}

